# Copy to .env (git-ignored) or set as real environment variables on your host.
# Never commit real values.
PORT=8080
# Long random string. Every viewer (phone/web) needs it. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
STSMN_VIEWER_KEY=
# Where devices.json is stored (private folder, not public)
STSMN_DATA_DIR=./data
# Set to 1 ONLY when running behind a TLS reverse proxy (Render, Fly, Caddy, nginx) so client IPs are read from X-Forwarded-For
STSMN_TRUST_PROXY=0
